  const resume = {
    id: randomUUID(),
    userId: req.auth.userId,
    fileName,
    fileType: 'text/plain',
    text,
    createdAt: safeDate(),
  };
  const report = {
    id: randomUUID(),
    userId: req.auth.userId,
    resumeId: resume.id,
    ...analyzeResume(text, profile, jobDescription),
    createdAt: safeDate(),
  };
  db.resumes.push(resume);
  db.atsReports.push(report);
  await writeDb(db);
  res.json({ resume, report });
});

