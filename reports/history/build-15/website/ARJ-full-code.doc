:root {
  color-scheme: dark;
  --bg: #0c111d;
  --bg-2: #111827;
  --surface: #151d2b;
  --surface-2: #1b2638;
  --surface-3: #223049;
  --text: #edf2f7;
  --muted: #9aa8bc;
  --soft: #718096;
  --line: rgba(226, 232, 240, 0.12);
  --line-strong: rgba(226, 232, 240, 0.2);
  --accent: #38bdf8;
  --accent-2: #34d399;
  --accent-3: #f97316;
  --accent-4: #eab308;
  --danger: #fb7185;
  --good: #34d399;
  --warning: #f59e0b;
  --shadow: 0 18px 42px rgba(0, 0, 0, 0.28);
}

:root[data-theme='light'] {
  color-scheme: light;
  --bg: #f6f7fb;
  --bg-2: #eef2f7;
  --surface: #ffffff;
  --surface-2: #f8fafc;
  --surface-3: #e8eef6;
  --text: #101828;
  --muted: #526172;
  --soft: #7a8797;
  --line: rgba(15, 23, 42, 0.12);
  --line-strong: rgba(15, 23, 42, 0.2);
  --shadow: 0 18px 42px rgba(15, 23, 42, 0.1);
}

body {
  background:
    linear-gradient(135deg, rgba(56, 189, 248, 0.1), transparent 34%),
    linear-gradient(315deg, rgba(249, 115, 22, 0.09), transparent 36%),
    var(--bg);
  color: var(--text);
}

a {
  color: inherit;
}

button,
input,
textarea,
select {
  letter-spacing: 0;
}

button {
  border: 0;
}

input,
textarea,
select {
  width: 100%;
  min-height: 42px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
  color: var(--text);
  padding: 10px 12px;
  outline: none;
}

textarea {
  min-height: 108px;
  resize: vertical;
}

input:focus,
textarea:focus,
select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.16);
}

.auth-page {
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(360px, 440px);
  gap: 32px;
  align-items: center;
  padding: 32px;
}

.auth-visual {
  min-height: calc(100vh - 64px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 56px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background:
    linear-gradient(140deg, rgba(56, 189, 248, 0.22), transparent 35%),
    linear-gradient(35deg, rgba(52, 211, 153, 0.17), transparent 36%),
    linear-gradient(315deg, rgba(249, 115, 22, 0.15), transparent 34%),
    var(--surface);
  box-shadow: var(--shadow);
}

.brand-mark,
.sidebar-brand,
.topbar-actions,
.panel-header,
.panel-header > div,
.page-action,
.button-row,
.role-meta,
.api-pill,
.input-wrap,
.demo-box {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: fit-content;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--accent);
  background: rgba(56, 189, 248, 0.1);
  font-weight: 800;
}

.auth-visual h1 {
  max-width: 820px;
  margin: 28px 0 18px;
  font-size: 54px;
  line-height: 1.04;
  letter-spacing: 0;
}

.auth-visual p {
  max-width: 690px;
  margin: 0;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.7;
}

.auth-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  width: min(620px, 100%);
  margin-top: 36px;
}

.metric-mini,
.auth-card,
.panel,
.metric-card,
.toast,
.status-card,
.mobile-nav,
.toolbar {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: color-mix(in srgb, var(--surface) 92%, transparent);
  box-shadow: var(--shadow);
}

.metric-mini {
  padding: 18px;
}

.metric-mini strong {
  display: block;
  font-size: 26px;
}

.metric-mini span {
  color: var(--muted);
  font-size: 13px;
}

.auth-card {
  padding: 28px;
}

.auth-card-head,
.topbar,
.page-header,
.application-head,
.application-row,
.job-row,
.history-row,
.role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.auth-card h2,
.page-header h2,
.panel h2,
.topbar h1 {
  margin: 0;
  letter-spacing: 0;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--accent);
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
}

.auth-form,
.form-grid,
.question-list,
.stack-list,
.recommendation-list,
.report-detail,
.report-notes,
.role-card-body,
.feedback-list {
  display: grid;
  gap: 14px;
}

.auth-form {
  margin-top: 24px;
}

label {
  display: grid;
  gap: 8px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

.input-wrap {
  gap: 8px;
  padding-left: 11px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
}

.input-wrap input {
  border: 0;
  background: transparent;
  box-shadow: none;
  padding-left: 0;
}

.primary-button,
.secondary-button,
.panel-action button,
.auth-actions button,
.button-row button,
.quick-prompts button,
.logout-button {
  min-height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 8px;
  padding: 10px 13px;
  color: var(--text);
  background: var(--surface-2);
  border: 1px solid var(--line);
  font-weight: 800;
}

.primary-button {
  background: linear-gradient(135deg, #0891b2, #16a34a);
  color: #ffffff;
  border-color: transparent;
}

.secondary-button {
  background: var(--surface);
}

.full-width {
  width: 100%;
}

.icon-button {
  width: 42px;
  height: 42px;
  display: inline-grid;
  place-items: center;
  border-radius: 8px;
  background: var(--surface-2);
  color: var(--text);
  border: 1px solid var(--line);
}

.auth-actions {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: 18px;
}

.auth-actions button {
  flex: 1;
  color: var(--muted);
}

.form-message {
  margin: 0;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 13px;
}

.form-message.success {
  color: var(--good);
  background: rgba(52, 211, 153, 0.1);
}

.form-message.error {
  color: var(--danger);
  background: rgba(251, 113, 133, 0.1);
}

.demo-box {
  gap: 8px;
  margin-top: 18px;
  padding: 12px;
  border-radius: 8px;
  background: rgba(234, 179, 8, 0.1);
  color: var(--accent-4);
  font-weight: 800;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 284px minmax(0, 1fr);
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 18px;
  border-right: 1px solid var(--line);
  background: rgba(12, 17, 29, 0.82);
  backdrop-filter: blur(16px);
}

:root[data-theme='light'] .sidebar {
  background: rgba(255, 255, 255, 0.9);
}

.sidebar-brand {
  gap: 12px;
  min-height: 58px;
}

.sidebar-brand strong {
  display: block;
  font-size: 18px;
}

.sidebar-brand small {
  display: block;
  color: var(--muted);
  margin-top: 2px;
}

.logo-tile,
.metric-icon {
  display: grid;
  place-items: center;
  border-radius: 8px;
  color: #001018;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
}

.logo-tile {
  width: 42px;
  height: 42px;
}

.sidebar-nav {
  display: grid;
  gap: 8px;
  margin-top: 24px;
}

.sidebar-nav button,
.logout-button {
  width: 100%;
  justify-content: flex-start;
  background: transparent;
  color: var(--muted);
  border: 1px solid transparent;
}

.sidebar-nav button {
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px 12px;
  border-radius: 8px;
  font-weight: 800;
}

.sidebar-nav button.active,
.sidebar-nav button:hover,
.logout-button:hover {
  color: var(--text);
  background: var(--surface-2);
  border-color: var(--line);
}

.sidebar-footer {
  display: grid;
  gap: 12px;
  margin-top: auto;
}

.status-card {
  display: flex;
  gap: 10px;
  padding: 12px;
  color: var(--muted);
  font-size: 13px;
}

.workspace {
  min-width: 0;
  padding: 22px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 4;
  min-height: 72px;
  margin: -22px -22px 22px;
  padding: 16px 22px;
  border-bottom: 1px solid var(--line);
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter: blur(16px);
}

.topbar h1 {
  font-size: 24px;
}

.topbar-actions {
  gap: 10px;
}

.api-pill {
  gap: 7px;
  min-height: 36px;
  padding: 0 11px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 800;
}

.api-pill.online {
  color: var(--good);
  background: rgba(52, 211, 153, 0.1);
}

.api-pill.offline {
  color: var(--danger);
  background: rgba(251, 113, 133, 0.1);
}

.toast {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
  padding: 12px 14px;
}

.toast button {
  display: grid;
  place-items: center;
  color: var(--muted);
  background: transparent;
}

.page-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 16px;
  align-items: start;
}

.span-4 {
  grid-column: span 4;
}

.span-5 {
  grid-column: span 5;
}

.span-6 {
  grid-column: span 6;
}

.span-7 {
  grid-column: span 7;
}

.span-8 {
  grid-column: span 8;
}

.span-12 {
  grid-column: span 12;
}

.page-header {
  padding: 8px 0 6px;
}

.page-header h2 {
  font-size: 30px;
}

.page-header p {
  max-width: 820px;
  margin: 8px 0 0;
  color: var(--muted);
  line-height: 1.6;
}

.panel {
  min-width: 0;
  padding: 16px;
}

.panel-header {
  justify-content: space-between;
  margin-bottom: 15px;
}

.panel-header > div {
  gap: 9px;
}

.panel h2 {
  font-size: 16px;
}

.panel h3 {
  margin: 0 0 10px;
  font-size: 14px;
}

.panel p,
.muted {
  color: var(--muted);
  line-height: 1.55;
}

.panel-action button {
  min-height: 34px;
  padding: 7px 10px;
  color: var(--muted);
  font-size: 13px;
}

.metric-grid {
  grid-column: span 12;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.metric-card {
  padding: 16px;
}

.metric-icon {
  width: 40px;
  height: 40px;
  margin-bottom: 16px;
}

.metric-card span,
.metric-card small {
  display: block;
  color: var(--muted);
}

.metric-card strong {
  display: block;
  margin: 8px 0 4px;
  font-size: 30px;
}

.metric-card.excellent .metric-icon,
.score-badge.excellent {
  background: linear-gradient(135deg, #10b981, #38bdf8);
}

.metric-card.good .metric-icon,
.score-badge.good {
  background: linear-gradient(135deg, #38bdf8, #6366f1);
}

.metric-card.needs-work .metric-icon,
.score-badge.needs-work {
  background: linear-gradient(135deg, #f97316, #fb7185);
}

.ats-snapshot,
.report-layout {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  gap: 22px;
  align-items: center;
}

.score-ring {
  --score: 0deg;
  width: 148px;
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: conic-gradient(var(--accent-2) var(--score), var(--surface-3) 0);
}

.score-ring > div {
  width: 104px;
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--surface);
  text-align: center;
}

.score-ring strong {
  display: block;
  font-size: 32px;
}

.score-ring span {
  display: block;
  color: var(--muted);
  font-size: 12px;
  font-weight: 800;
}

.score-ring.compact {
  width: 112px;
}

.score-ring.compact > div {
  width: 78px;
}

.pill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.pill-list span,
.chance-pill,
.score-badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-height: 28px;
  border-radius: 8px;
  padding: 5px 9px;
  color: var(--text);
  background: var(--surface-3);
  font-size: 12px;
  font-weight: 800;
}

.chance-pill.high {
  color: var(--good);
  background: rgba(52, 211, 153, 0.1);
}

.chance-pill.medium {
  color: var(--warning);
  background: rgba(245, 158, 11, 0.1);
}

.chance-pill.low {
  color: var(--danger);
  background: rgba(251, 113, 133, 0.1);
}

.role-row,
.history-row,
.job-row {
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
}

.role-row strong,
.history-row strong,
.job-row strong {
  display: block;
  font-size: 14px;
}

.role-row span,
.history-row span,
.job-row span {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 12px;
}

.mini-progress {
  min-width: 138px;
  display: grid;
  grid-template-columns: 1fr 42px;
  gap: 10px;
  align-items: center;
}

.progress-track {
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: var(--surface-3);
}

.progress-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
}

.sparkline {
  min-height: 220px;
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10px;
  align-items: end;
}

.spark-day {
  display: grid;
  gap: 7px;
  text-align: center;
}

.spark-day small,
.spark-day strong {
  color: var(--muted);
  font-size: 12px;
}

.spark-bar {
  height: 150px;
  display: flex;
  align-items: end;
  border-radius: 8px;
  background: var(--surface-2);
  overflow: hidden;
}

.spark-bar span {
  width: 100%;
  min-height: 6px;
  background: linear-gradient(180deg, var(--accent), var(--accent-2));
}

.recommendation-item {
  padding: 12px;
  border-left: 3px solid var(--accent);
  border-radius: 8px;
  background: var(--surface-2);
}

.recommendation-item span {
  color: var(--accent);
  font-size: 12px;
  font-weight: 900;
}

.recommendation-item strong {
  display: block;
  margin: 5px 0;
}

.recommendation-item p {
  margin: 0;
  font-size: 13px;
}

.upload-zone {
  position: relative;
  min-height: 170px;
  place-items: center;
  padding: 24px;
  border: 1px dashed var(--line-strong);
  border-radius: 8px;
  color: var(--muted);
  background: var(--surface-2);
  text-align: center;
}

.upload-zone strong {
  color: var(--text);
}

.upload-zone input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

.resume-textarea {
  margin-top: 12px;
  min-height: 180px;
}

.resume-textarea.compact {
  min-height: 110px;
}

.report-layout {
  grid-template-columns: 150px minmax(0, 1fr);
}

.report-notes {
  grid-column: 1 / -1;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.section-score-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.section-score {
  display: grid;
  gap: 7px;
}

.section-score span {
  color: var(--muted);
  font-size: 12px;
  text-transform: capitalize;
}

.plain-list,
.roadmap-list {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
}

.plain-list li,
.roadmap-list li {
  margin: 8px 0;
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.template-card {
  min-height: 76px;
  display: grid;
  align-content: center;
  gap: 6px;
  padding: 12px;
  text-align: left;
  border-radius: 8px;
  border: 1px solid var(--line);
  color: var(--text);
  background: var(--surface-2);
}

.template-card.selected {
  border-color: var(--accent);
  background: rgba(56, 189, 248, 0.1);
}

.template-card span {
  font-weight: 900;
}

.template-card small {
  color: var(--muted);
}

.resume-preview {
  margin-top: 14px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #f8fafc;
  color: #111827;
  --template-accent: #0f172a;
}

.resume-preview p,
.resume-preview .muted {
  color: #475569;
}

.resume-preview-head {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--template-accent);
}

.resume-preview-head h3 {
  color: #111827;
  font-size: 22px;
}

.resume-preview-head span {
  color: var(--template-accent);
  font-weight: 900;
}

.resume-preview-body {
  display: grid;
  grid-template-columns: 0.78fr 1.4fr;
  gap: 18px;
  margin-top: 14px;
}

.resume-preview-body aside {
  display: grid;
  align-content: start;
  gap: 8px;
  padding: 12px;
  border-radius: 8px;
  background: #eef2f7;
}

.resume-preview-body main {
  min-width: 0;
}

.resume-preview-section {
  margin-top: 14px;
}

.resume-preview.executive,
.resume-preview.executive-focus {
  background: #fbfbf5;
}

.resume-preview.grid,
.resume-preview.technical-grid {
  background: #f0f9ff;
}

.resume-preview.grid .resume-preview-body,
.resume-preview.technical-grid .resume-preview-body {
  grid-template-columns: 1fr 1fr;
}

.resume-preview.student,
.resume-preview.internship-spark {
  background: #fff7ed;
}

.resume-preview.global,
.resume-preview.global-remote {
  background: #f0fdfa;
}

.resume-preview.minimal,
.resume-preview.minimal-impact {
  background: #ffffff;
}

.resume-preview.minimal .resume-preview-body,
.resume-preview.minimal-impact .resume-preview-body {
  grid-template-columns: 1fr;
}

.resume-preview.project,
.resume-preview.project-led {
  background: #fff1f2;
}

.resume-preview.project .resume-preview-body,
.resume-preview.project-led .resume-preview-body {
  grid-template-columns: 0.55fr 1.6fr;
}

.resume-preview.analytics,
.resume-preview.data-analytics {
  background: #fffbeb;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
}

.toolbar > span {
  color: var(--muted);
  font-weight: 800;
}

.job-bucket-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.job-bucket-grid button {
  display: grid;
  gap: 4px;
  min-height: 74px;
  align-content: center;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--muted);
  background: var(--surface);
  text-align: left;
  padding: 12px;
}

.job-bucket-grid button.active {
  color: var(--text);
  border-color: var(--accent);
  background: rgba(56, 189, 248, 0.1);
}

.job-bucket-grid strong {
  font-size: 24px;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
  padding-left: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
}

.search-box input {
  border: 0;
  background: transparent;
  box-shadow: none;
}

.role-score-line {
  display: grid;
  grid-template-columns: 1fr 54px;
  gap: 12px;
  align-items: center;
}

.role-meta {
  flex-wrap: wrap;
  gap: 9px;
}

.role-meta span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 30px;
  padding: 5px 9px;
  border-radius: 8px;
  color: var(--muted);
  background: var(--surface-2);
  font-size: 12px;
  font-weight: 800;
}

.salary-text {
  color: var(--accent-4) !important;
  font-weight: 900;
}

.button-row {
  flex-wrap: wrap;
  gap: 8px;
}

.button-row button {
  flex: 1;
  min-width: 130px;
}

.platform-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.platform-grid a {
  min-height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--text);
  background: var(--surface-2);
  text-decoration: none;
  font-size: 12px;
  font-weight: 800;
}

.question-block {
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
}

.question-block span {
  color: var(--accent);
}

.question-block strong {
  color: var(--text);
}

.feedback-row {
  display: grid;
  gap: 4px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
}

.feedback-row span {
  color: var(--muted);
  font-size: 13px;
}

.chat-panel {
  min-height: calc(100vh - 150px);
}

.quick-prompts {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.quick-prompts button {
  color: var(--muted);
  min-height: 34px;
  padding: 7px 10px;
  font-size: 13px;
}

.chat-feed {
  height: 52vh;
  min-height: 360px;
  overflow: auto;
  display: grid;
  align-content: start;
  gap: 12px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
}

.chat-message {
  width: min(78%, 720px);
  display: grid;
  gap: 5px;
  padding: 12px;
  border-radius: 8px;
}

.chat-message span {
  font-size: 12px;
  font-weight: 900;
}

.chat-message p {
  margin: 0;
  color: var(--text);
  white-space: pre-wrap;
}

.chat-message.user {
  justify-self: end;
  background: rgba(56, 189, 248, 0.18);
}

.chat-message.ai {
  justify-self: start;
  background: var(--surface);
}

.chat-composer {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  margin-top: 12px;
}

.form-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.form-grid.one-column {
  grid-template-columns: 1fr;
}

.form-grid .wide {
  grid-column: 1 / -1;
}

.application-table {
  display: grid;
  gap: 8px;
}

.application-head {
  padding: 0 12px 8px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.application-row {
  grid-template-columns: 1.3fr 0.7fr 170px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
}

.application-row strong {
  display: block;
}

.application-row span {
  color: var(--muted);
  font-size: 13px;
}

.empty-state {
  min-height: 160px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 10px;
  padding: 24px;
  text-align: center;
  color: var(--muted);
}

.empty-state strong {
  color: var(--text);
}

.empty-state p {
  max-width: 440px;
  margin: 0;
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 1180px) {
  .auth-page {
    grid-template-columns: 1fr;
  }

  .auth-visual {
    min-height: auto;
  }

  .span-4,
  .span-5,
  .span-6,
  .span-7,
  .span-8 {
    grid-column: span 12;
  }

  .metric-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 860px) {
  .app-shell {
    display: block;
    padding-bottom: 76px;
  }

  .sidebar {
    display: none;
  }

  .workspace {
    padding: 16px;
  }

  .topbar {
    margin: -16px -16px 16px;
    padding: 14px 16px;
  }

  .topbar h1 {
    font-size: 18px;
  }

  .topbar-actions .api-pill {
    display: none;
  }

  .page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .metric-grid,
  .auth-stats,
  .form-grid,
  .report-notes,
  .section-score-grid,
  .template-grid,
  .job-bucket-grid,
  .resume-preview-body,
  .platform-grid {
    grid-template-columns: 1fr;
  }

  .ats-snapshot,
  .report-layout {
    grid-template-columns: 1fr;
  }

  .chat-composer {
    grid-template-columns: 1fr;
  }

  .application-head {
    display: none;
  }

  .application-row {
    grid-template-columns: 1fr;
    align-items: start;
  }

  .mobile-nav {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    padding: 8px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(16px);
  }

  .mobile-nav button {
    min-height: 44px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    color: var(--muted);
    background: transparent;
  }

  .mobile-nav button.active {
    color: var(--text);
    background: var(--surface-2);
  }
}

@media (min-width: 861px) {
  .mobile-nav {
    display: none;
  }
}

@media (max-width: 620px) {
  .auth-page {
    padding: 12px;
  }

  .auth-visual {
    padding: 24px;
  }

  .auth-visual h1 {
    font-size: 34px;
  }

  .auth-card {
    padding: 18px;
  }

  .metric-grid {
    grid-template-columns: 1fr;
  }

  .toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .chat-message {
    width: 100%;
  }

  .sparkline {
    gap: 5px;
  }
}

